{
  "manifest_version": 3,
  "name": "YT KidGuard",
  "version": "1.0",
  "description": "Blocks specific keyword searches on YouTube",
  "permissions": ["storage"],
  "host_permissions": ["https://www.youtube.com/*"],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "KidGuard Settings"
  }
}
