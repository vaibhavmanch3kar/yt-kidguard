{
  "manifest_version": 3,
  "name": "KidGuard for YouTube",
  "version": "1.1.0",
  "description": "PIN-protected YouTube parental control. Block videos by keyword, set daily screen time limits and schedules. No data collected.",
  "permissions": ["storage", "alarms", "tabs"],
  "host_permissions": ["https://www.youtube.com/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "KidGuard Settings",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}
